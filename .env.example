# ===== Supabase (wajib) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci service role — HANYA dipakai server-side (seed/setup), JANGAN pernah dipakai di client
SUPABASE_SERVICE_ROLE_KEY=

# ===== Bootstrap admin (wajib di production) =====
# Dipakai /api/admin/setup untuk membuat admin pertama.
# Atur nilai rahasia acak (contoh: karsa-bootstrap-$(openssl rand -hex 12)).
KARSA_SETUP_SECRET=